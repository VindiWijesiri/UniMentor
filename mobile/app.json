{
  "expo": {
    "name": "UniMentor",
    "slug": "unimentor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unimentor.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.unimentor.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "unimentor",
    "experiments": {
      "tsconfigPaths": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "UniMentor needs access to your camera for live video mentoring sessions.",
          "microphonePermission": "UniMentor needs access to your microphone to speak during live video sessions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "UniMentor needs access to your photos to upload profile and verification photos.",
          "cameraPermission": "UniMentor needs access to your camera to scan and verify your face for session bookings."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0026cf68-fc7d-4216-b81b-4723d2603f04"
      }
    },
    "owner": "2026oslo"
  }
}
